# Configuração do Firebase para este projeto.
# Copie este ficheiro para ".env" e preencha com os valores do seu projeto Firebase
# (Firebase Console > Definições do projeto > Geral > As suas apps > Configuração do SDK).
# Ver docs/DEPLOYMENT.md para o guia passo-a-passo completo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Moeda por defeito da aplicação (pode também ser alterada em Configurações após o login)
VITE_DEFAULT_CURRENCY_CODE=MZN
VITE_DEFAULT_CURRENCY_SYMBOL=MT
